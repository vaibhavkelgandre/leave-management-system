PORT=5001

NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=leave_management_system
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Set instead of DB_HOST/etc in production (Render/Railway managed Postgres).
# Takes precedence over every DB_* var above whenever it is non-empty, so
# leaving it set in a shell aims *everything* in that shell at that database —
# migrations and the test suite alike. Prefer setting it for a single command.
# The integration suite refuses to run if this names a non-'_test' database
# (src/tests/integration/helpers/testDatabaseGuard.js); keep a blank
# DATABASE_URL= line in .env.test so a stray shell value can't reach it.
DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=lms_token

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173

GOOGLE_CLIENT_ID=783513070491-e36undssm9pr63cv1snabjq0v1s5of23.apps.googleusercontent.com

# Shared secret required to self-register as the first/next HR admin
# Password given to the three demo.* accounts created by `npm run seed`.
# Required by that script and deliberately never defaulted — a seed script that
# invents a password nobody chose is a credential nobody knows they published.
# Set it for the one command rather than leaving it in this file.
DEMO_PASSWORD=

HR_REGISTRATION_CODE=

# IP-level rate limiting on the pre-auth endpoints (login, Google login,
# register/hr, password reset, invitation tokens) — see
# src/middlewares/rateLimiter.js for what each limit is and why.
# Leave unset: it is ON everywhere except NODE_ENV=test, where the integration
# suite's hundreds of loopback logins would trip it. Set to "false" only to
# switch it off deliberately (it is the app's only brute-force protection);
# set to "true" to exercise it under test. Read per request, so a change takes
# effect on restart without a code change.
RATE_LIMIT_ENABLED=

# How long an emailed invite link stays redeemable. Unaccepted invites expire
# after this many hours, and the pending account is then deleted so the email
# can be re-invited. Clamped to 1-72 in code (invitationService.js) and
# defaults to 12 when unset or unparseable, so a typo can't mint a link that
# stays valid for months. Shorter is safer but there is no resend endpoint:
# once it lapses, HR re-fills the whole invite form.
INVITE_TOKEN_TTL_HOURS=12

# Cloudinary account (Dashboard -> Product Environment Credentials)
# used for storing leave-request documents (e.g. medical certificates).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound email, used for every email in the app (password reset link,
# invite link, payslip PDF). Leave SENDGRID_API_KEY blank and nothing is sent
# — the message is console-logged instead, which is the local-dev fallback.
#
# SendGrid over HTTPS, not SMTP, and that is not a preference: Render blocks
# outbound SMTP on both 587 and 465 (TCP connect times out before TLS), so no
# SMTP configuration can deliver mail from there. See config/mailer.js.
#   - Create a key at app.sendgrid.com/settings/api_keys with the single
#     "Mail Send" permission; nothing else is needed.
#   - The MAIL_FROM address must be a verified sender
#     (app.sendgrid.com/settings/sender_auth). Single Sender Verification
#     confirms one address by email and needs no DNS access; verifying the
#     whole domain needs SPF/DKIM records but improves deliverability.
#   - Free tier is ~100 emails/day.
#
# MAIL_FROM takes a display name: Leave Management System <you@example.com>
# Do NOT wrap it in quotes when setting it in a hosting dashboard (Render et
# al) — dotenv strips surrounding quotes from this file, but a dashboard
# stores them literally. Quotes are only needed here, and only if the value
# contains a '#'. Unlike the old SMTP setup there is no fallback sender: with
# MAIL_FROM unset the app treats mail as unconfigured and logs instead.
SENDGRID_API_KEY=
MAIL_FROM=

# Outbound email feature flags (server/src/config/mailFeatures.js). Every flow
# is listed here; set one to false to switch that email off without a code
# change. Unset or unrecognized values fall back to the default shown.
# Accepted spellings: true/false, 1/0, yes/no, on/off, enabled/disabled.
#
# MAIL_ENABLED is a global kill switch that overrides all of them — one
# variable to stop all outbound mail during an incident or a data migration.
MAIL_ENABLED=true
# Forgot-password link. Switching this off disables password recovery
# entirely: it is the only flow with no non-email delivery path.
MAIL_FEATURE_PASSWORD_RESET=true
# Invite link. Safe to switch off — HR still gets the link in the API
# response and can share it another way.
MAIL_FEATURE_EMPLOYEE_INVITE=true
# Payslip PDF after a payroll run. Safe to switch off — the in-app
# notification and the download endpoint keep working.
MAIL_FEATURE_SALARY_SLIP=true
